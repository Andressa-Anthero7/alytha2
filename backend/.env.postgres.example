DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=alytha-local-postgres-development-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,plataforma.alytha.agr.br
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://plataforma.alytha.agr.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://plataforma.alytha.agr.br

DATABASE_URL=postgresql://alytha:alytha_local_password@127.0.0.1:5432/alytha
DJANGO_DB_CONN_MAX_AGE=0

ALYTHA_PUBLIC_SITE_URL=https://plataforma.alytha.agr.br
ALYTHA_SHARE_IMAGE_URL=https://plataforma.alytha.agr.br/logo.png
ALYTHA_FRONTEND_DIST_DIR=../frontend/dist
ALYTHA_EXPOSE_PASSWORD_RESET_TOKEN=true

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
