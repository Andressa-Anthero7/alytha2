# Base URL da API para desenvolvimento ou build local
VITE_API_BASE_URL="http://127.0.0.1:8000/api"

# URL publica do frontend usada nos links compartilhados e metadados
VITE_PUBLIC_SITE_URL="https://plataforma.alytha.agr.br"

# URL publica do backend para previews server-side do Facebook
VITE_SHARE_BASE_URL="https://plataforma.alytha.agr.br"

# Alvo do proxy Vite em desenvolvimento
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"

# Contatos comerciais exibidos nas páginas públicas
VITE_SUPPORT_EMAIL="suporte@alytha.agr.br"
VITE_SUPPORT_WHATSAPP="+55 16 99337-9492"

# ID da tag do Google Analytics/Google tag. Exemplo: G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID="G-ZNSG9BH609"

# Google Maps JavaScript API usado no mapa do marketplace
VITE_GOOGLE_MAPS_API_KEY="sua-chave-do-google-maps"
# Opcional. Se ficar vazio, o frontend usa DEMO_MAP_ID para os marcadores avancados.
VITE_GOOGLE_MAPS_MAP_ID=""
